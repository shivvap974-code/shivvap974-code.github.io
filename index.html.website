<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shiva Prasad | Portfolio</title>
<meta name="description" content="Portfolio of Shiva Prasad, [YOUR ROLE] based in [YOUR CITY]. See selected work and get in touch.">
<meta property="og:title" content="Shiva Prasad | Portfolio">
<meta property="og:description" content="Portfolio of Shiva Prasad, [YOUR ROLE] based in [YOUR CITY].">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap">
<style>
:root {
  --bg: #F3F5F4;
  --surface: #FFFFFF;
  --ink: #14201C;
  --muted: #3F524C;
  --line: #C9D4D0;
  --tile: #DCE5E1;
  --accent: #0F6B5C;
  --dark-muted: #B8C4BF;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.6;
}
a { color: var(--accent); }
a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
h1, h2, h3 { font-family: 'Space Grotesk', system-ui, sans-serif; margin: 0; text-wrap: balance; }
p { margin: 0; }
.wrap { max-width: 1120px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
.eyebrow { font-weight: 600; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }

/* nav */
.nav { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding-top: 24px; padding-bottom: 24px; }
.brand { font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 700; font-size: 22px; letter-spacing: -0.01em; }
.nav ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
.nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 10px 16px; display: inline-block; }
.nav a:hover { color: var(--accent); }

/* hero */
.hero { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-top: 72px; padding-bottom: 104px; }
.hero-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
.hero h1 { font-size: clamp(40px, 7vw, 60px); line-height: 1.05; letter-spacing: -0.03em; }
.lead { font-size: 20px; color: var(--muted); max-width: 520px; }
.buttons { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
.btn { display: inline-block; text-decoration: none; font-weight: 600; padding: 14px 26px; border-radius: 6px; border: 2px solid transparent; }
.btn-primary { background: var(--accent); color: #FFFFFF; }
.btn-primary:hover { background: #0A4A40; color: #FFFFFF; }
.btn-outline { color: var(--ink); border-color: var(--ink); }
.btn-outline:hover { background: var(--ink); color: #FFFFFF; }
.photo { flex: 1 1 280px; max-width: 380px; min-width: 0; aspect-ratio: 4 / 5; background: var(--tile); border: 2px dashed #7C918A; border-radius: 6px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; color: var(--muted); font-weight: 500; }

/* work */
.work { background: var(--surface); }
.work .wrap { padding-top: 88px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 40px; }
.section-head { display: flex; flex-direction: column; gap: 12px; }
h2 { font-size: 40px; line-height: 1.1; letter-spacing: -0.02em; }
.section-head p { color: var(--muted); max-width: 560px; }
.cards { display: flex; flex-wrap: wrap; gap: 32px; }
.card { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
.thumb { aspect-ratio: 3 / 2; background: var(--tile); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-weight: 500; }
.card h3 { font-size: 22px; }
.card p { color: var(--muted); }
.tags { font-size: 14px; font-weight: 600; color: var(--accent); }

/* about */
.about { display: flex; flex-wrap: wrap; gap: 56px; padding-top: 96px; padding-bottom: 96px; }
.about-text { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
.about-text p { color: var(--muted); max-width: 560px; }
.about-lists { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
.list { display: flex; flex-direction: column; gap: 12px; }
.list ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.list li { padding-bottom: 8px; border-bottom: 1px solid var(--line); }

/* contact */
.contact { background: var(--ink); color: var(--bg); }
.contact .wrap { padding-top: 88px; padding-bottom: 88px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 40px; }
.contact-text { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
.contact h2 { font-size: 44px; }
.contact-text p { color: var(--dark-muted); max-width: 480px; }
.contact-details { flex: 0 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
.label { font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dark-muted); }
.value { font-size: 20px; font-weight: 500; overflow-wrap: anywhere; }

/* footer */
footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 28px; padding-bottom: 28px; font-size: 14px; color: var(--muted); }
footer a { color: var(--muted); }

@media (max-width: 600px) {
  .wrap { padding-left: 20px; padding-right: 20px; }
  .hero { padding-top: 40px; padding-bottom: 64px; gap: 40px; }
  h2, .contact h2 { font-size: 32px; }
  .about { padding-top: 64px; padding-bottom: 64px; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
</style>
</head>
<body>

<header class="wrap nav">
  <div class="brand">Shiva Prasad</div>
  <nav aria-label="Main">
    <ul>
      <li><a href="#work">Work</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>
</header>

<main>
  <section class="wrap hero">
    <div class="hero-text">
      <div class="eyebrow">[YOUR ROLE] · [YOUR CITY]</div>
      <h1>Hi, I'm Shiva Prasad.</h1>
      <p class="lead">[ONE SENTENCE ON WHAT YOU DO AND WHO YOU DO IT FOR.]</p>
      <div class="buttons">
        <a class="btn btn-primary" href="#work">See my work</a>
        <a class="btn btn-outline" href="#contact">Get in touch</a>
      </div>
    </div>
    <div class="photo">[YOUR PHOTO]</div>
  </section>

  <section class="work" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected work</h2>
        <p>[A LINE ABOUT THE KIND OF PROJECTS YOU'RE PROUD OF.]</p>
      </div>
      <div class="cards">
        <article class="card">
          <div class="thumb">[PROJECT IMAGE]</div>
          <h3>[PROJECT NAME 1]</h3>
          <p>[TWO SENTENCES: THE PROBLEM, WHAT YOU DID, THE RESULT.]</p>
          <div class="tags">[TAG] · [TAG]</div>
        </article>
        <article class="card">
          <div class="thumb">[PROJECT IMAGE]</div>
          <h3>[PROJECT NAME 2]</h3>
          <p>[TWO SENTENCES: THE PROBLEM, WHAT YOU DID, THE RESULT.]</p>
          <div class="tags">[TAG] · [TAG]</div>
        </article>
        <article class="card">
          <div class="thumb">[PROJECT IMAGE]</div>
          <h3>[PROJECT NAME 3]</h3>
          <p>[TWO SENTENCES: THE PROBLEM, WHAT YOU DID, THE RESULT.]</p>
          <div class="tags">[TAG] · [TAG]</div>
        </article>
      </div>
    </div>
  </section>

  <section class="wrap about" id="about">
    <div class="about-text">
      <h2>About me</h2>
      <p>[A SHORT PARAGRAPH ABOUT YOUR BACKGROUND AND WHAT YOU CARE ABOUT.]</p>
      <p>[A SECOND PARAGRAPH ABOUT HOW YOU LIKE TO WORK.]</p>
    </div>
    <div class="about-lists">
      <div class="list">
        <div class="eyebrow">What I do</div>
        <ul>
          <li>[SKILL OR SERVICE 1]</li>
          <li>[SKILL OR SERVICE 2]</li>
          <li>[SKILL OR SERVICE 3]</li>
          <li>[SKILL OR SERVICE 4]</li>
        </ul>
      </div>
      <div class="list">
        <div class="eyebrow">Experience</div>
        <ul>
          <li>[YEAR – YEAR] · [ROLE], [COMPANY]</li>
          <li>[YEAR – YEAR] · [ROLE], [COMPANY]</li>
          <li>[YEAR – YEAR] · [ROLE], [COMPANY]</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <div class="contact-text">
        <h2>Let's work together.</h2>
        <p>[A LINE ABOUT WHAT KIND OF WORK YOU'RE OPEN TO RIGHT NOW.]</p>
      </div>
      <div class="contact-details">
        <div>
          <div class="label">Email</div>
          <div class="value">[YOUR EMAIL]</div>
        </div>
        <div>
          <div class="label">LinkedIn</div>
          <div class="value">[YOUR LINKEDIN LINK]</div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div>© 2026 Shiva Prasad</div>
    <a href="#top">Back to top</a>
  </div>
</footer>

</body>
</html>
